# RAM tier: 96gb -- UNTESTED, starting point
# About 56% of RAM. Raise or lower in 2-4 GiB steps while watching swap.
# Arena size in MiB (55296 MiB = 54 GiB).
# Arena sized automatically from RAM and context length, capped at the previous fixed size (untested).
LLAMA_DSV41_MOE_CACHE_MIB=auto
LLAMA_DSV41_MOE_CACHE_MAX_MIB=55296
