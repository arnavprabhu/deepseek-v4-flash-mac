# RAM tier: 128gb -- UNTESTED, starting point
# About 56% of RAM. Strata measured instability with 90-100 GB arenas on a 128 GB machine, so do not go that high.
# Arena size in MiB (73728 MiB = 72 GiB).
# Arena sized automatically from RAM and context length, capped at the previous fixed size (untested).
LLAMA_DSV41_MOE_CACHE_MIB=auto
LLAMA_DSV41_MOE_CACHE_MAX_MIB=73728
